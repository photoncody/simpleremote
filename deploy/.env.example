# SimpleRemote configuration. Every setting is an environment variable.
# Any variable can instead be read from a file by setting NAME_FILE=/path
# (useful with Docker secrets), e.g. OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc.

# ---- Required -------------------------------------------------------------

# The address techs and users open in their browser. Used for OIDC redirects
# and baked into each agent download.
PUBLIC_URL=https://support.example.com

# Shown to end users on the code page and in the agent's consent prompt.
ORG_NAME=Example IT

# Random string, at least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ---- Single sign-on (OIDC) -------------------------------------------------
# Register a "web" application with your identity provider using the redirect
# URI  ${PUBLIC_URL}/auth/oidc/callback

OIDC_ISSUER=https://login.example.com/realms/example
OIDC_CLIENT_ID=simpleremote
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Button label on the sign-in page.
# OIDC_PROVIDER_NAME=Single sign-on
# Send techs straight to the identity provider (default true). The backup
# admin page at /tech/login/local always stays reachable.
# OIDC_AUTO_LOGIN=true

# Who may sign in. Anyone matching ANY rule is allowed. At least one rule (or
# OIDC_ALLOW_ALL=true) is required when OIDC is enabled.
OIDC_ALLOWED_GROUPS=helpdesk
# OIDC_ALLOWED_EMAILS=alice@example.com,bob@example.com
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_GROUPS_CLAIM=groups
# OIDC_ALLOW_ALL=false

# ---- Backup admin -----------------------------------------------------------
# For when SSO is down. Sign in at ${PUBLIC_URL}/tech/login/local.
# Create a hash with:
#   docker run --rm -i ghcr.io/photoncody/simpleremote hash-password
# In this file, write each $ in the hash as $$ (Docker Compose would otherwise
# treat it as a variable), or put the hash in a file and use
# ADMIN_PASSWORD_HASH_FILE instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=   # plain text, at least 12 characters; not recommended

# ---- Connectivity (STUN/TURN) ----------------------------------------------
# Use the coturn service from docker-compose.yml (replace with your host).
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Shared with coturn. Generate with: openssl rand -hex 32
TURN_SECRET=
# TURN_REALM=simpleremote
# TURN_CRED_TTL=4h15m

# ---- Sessions -----------------------------------------------------------------
# How long a new code stays valid before the user enters it.
# CODE_TTL=10m
# Hard limit on a session's length.
# SESSION_MAX_DURATION=4h
# Allow a tech to keep a live session connected across a restart of the user's
# computer ("stay connected after restart"). The agent installs a per-user
# autostart (no service, no admin) that is removed when the session ends.
# REBOOT_RECONNECT=true
# How long the server holds the session open while the computer restarts.
# REBOOT_GRACE=10m
# How long a tech stays signed in.
# TECH_SESSION_TTL=12h
# Days to keep audit records (0 = forever).
# AUDIT_RETENTION_DAYS=365

# ---- Server -----------------------------------------------------------------
# LISTEN_ADDR=:8080
# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDRs).
# TRUSTED_PROXIES=172.16.0.0/12
# DATA_DIR=/data
# AGENT_DIR=/app/agents
# LOG_LEVEL=info
